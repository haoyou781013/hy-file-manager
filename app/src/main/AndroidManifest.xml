<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 11+ 文件管理需要「所有文件访问权限」 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 软件更新检查：向 Gitee / GitHub 拉取 versions.json。
         这是本项目唯一的网络请求；文件操作本身全部本地完成。
         缺少此权限会导致 update 检查抛 SecurityException（已实测）。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 长任务保活：压缩/解压/复制大目录时防止后台被杀留下半截文件 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

        <!--
      Android 11+ 包可见性（Package Visibility）：
      不声明的话 getInstalledApplications / getApplicationInfo / queryIntentActivities
      只能看到很少的系统应用（实测仅 11 个），第三方应用（MT 管理器等）完全不可见。
      这里声明需要探测的应用类型，让「打开方式」能列出设备上真实的应用。
    -->
    <queries>
        <!-- 能查看文件的应用池 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="file" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- 能编辑/发送文件的应用 -->
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>
        <!-- 能安装 APK 的应用 -->
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
        </intent>
        <!-- 文件管理器常用包名兜底（部分管理器不声明 VIEW） -->
        <package android:name="bin.mt.plus" />
        <package android:name="bin.mt.plus.canary" />
        <package android:name="com.estrongs.android.pop" />
        <package android:name="com.mixplorer" />
        <package android:name="ru.zdevs.zarchiver" />
        <package android:name="com.speedsoftware.rootexplorer" />
        <package android:name="com.termux" />
    </queries>

<application
        android:name=".HYApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.HYFileManager">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
            <activity
            android:name=".ImageViewerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="false" />
            <activity
            android:name=".MediaPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="false" />
            <activity
            android:name=".crash.CrashActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Black.NoTitleBar" />
            <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
            <activity
            android:name=".font.FontPreviewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar" />

        <!-- 长任务保活服务：dataSync 类型（文件读写场景的正确类型，
             不用 specialUse——Google Play 对该类型有额外审查） -->
        <service
            android:name=".service.TaskKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
