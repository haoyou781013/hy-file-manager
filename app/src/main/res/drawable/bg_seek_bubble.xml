<?xml version="1.0" encoding="utf-8"?>
<!--
  进度条拖动时跟随的时间气泡。

  ── 为什么需要它 ──
  143 分钟的视频，轨道约 900px，每像素 ≈ 9.5 秒。
  在这种精度下，用户拖动时看"进度条位置"是没用的——
  挪 10px 就是 95 秒。唯一可靠的反馈是精确的时间数字。

  旧实现在拖动时把 tvPos（左侧时间）改成目标时间，
  但那个位置离手指很远，且字号只有 12sp，拖动中根本看不清。

  ── 设计要点（调研自 YouTube / B 站 / 优设网分析）──
  ① 跟随手指上方 40dp，不遮住手指
  ② 深色实心背景 + 白字，任何画面下都清晰
  ③ 圆角 8dp，与播放器其它胶囊元素（chip）一致
  ④ 用 16sp 加粗 —— 拖动时这是唯一的视觉焦点，必须够大
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="#F01A1A1A" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
