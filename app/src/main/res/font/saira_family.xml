<?xml version="1.0" encoding="utf-8"?>
<!--
  Saira 可变字体族（endfield-ui-skill 规范）

  变体轴（来自 tokens.json font.width）：
    field     = 112  字段小字（编号/日期/计数）
    label     = 125  标签、字标、大写眉标
  字重（font.weight）：
    body 400 / label 600 / button 700 / heading 700 / display 800

  API 26+ 支持 fontVariationSettings；minSdk 23，低版本自动回退到默认实例。
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/saira"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/saira"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/saira"
        android:fontStyle="normal"
        android:fontWeight="700" />
    <font
        android:font="@font/saira"
        android:fontStyle="normal"
        android:fontWeight="800" />
</font-family>
