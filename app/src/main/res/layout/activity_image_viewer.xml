<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/iv_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 图片区：ViewPager2 承载图集（跟手左右拖动、相邻图可见），
         每个页面内部仍是一个支持双指缩放/拖动的 ImageView。
         这样既能像主流相册一样滑看下一张，放大后拖动看边缘也不冲突。 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/iv_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部：返回 + 文件名 + 尺寸。
         颜色由代码按「栏出=白底 / 栏藏=黑底」双模式动态控制，
         scrim 与文字色不写死在 XML。 -->
    <LinearLayout
        android:id="@+id/iv_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/btn_iv_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="返回"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tv_iv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_iv_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 底部功能栏：计数行 + 分享 / 删除 / 设为背景。
         与顶栏同为「点击画面唤出、再点隐藏」，颜色由代码按双模式控制。
         计数行在按钮上方居中，比顶栏右侧更醒目。 -->
    <LinearLayout
        android:id="@+id/iv_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tv_iv_counter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text=""
            android:textSize="13sp"
            android:paddingBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_iv_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_ripple">

            <ImageView
                android:id="@+id/iv_share_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_share"
                android:contentDescription="分享" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="分享"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_iv_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_ripple">

            <ImageView
                android:id="@+id/iv_delete_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_trash"
                android:contentDescription="删除" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="删除"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_iv_wallpaper"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_ripple">

            <ImageView
                android:id="@+id/iv_wallpaper_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_img"
                android:contentDescription="设为背景" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="设为背景"
                android:textSize="11sp" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
