<?xml version="1.0" encoding="utf-8"?>
<!--
  终末地风味主题色板（endfield-ui-skill）
  来源：assets/tokens.json (color.light / color.dark)
  规范要点：
    - 一种强调色 signal(#FFFA00)，只表示「当前位置 / 可点击 / 醒目提醒」，只做填充不铺底
    - 红色 danger 只给删除
    - 用 1px 细线 rule 分区，不用阴影/发光/渐变
-->
<resources>
    <!-- 浅色（纸） -->
    <color name="ef_paper_light">#FFF4F4F2</color>
    <color name="ef_panel_light">#FFFFFFFF</color>
    <color name="ef_ink_light">#FF161616</color>
    <color name="ef_ink2_light">#FF5C5C5C</color>
    <color name="ef_rule_light">#FFD9D9D6</color>
    <color name="ef_chip_light">#FFE4E4E0</color>

    <!-- 深色（墨） -->
    <color name="ef_paper_dark">#FF191919</color>
    <color name="ef_panel_dark">#FF222222</color>
    <color name="ef_ink_dark">#FFEDEDED</color>
    <color name="ef_ink2_dark">#FFA3A3A3</color>
    <color name="ef_rule_dark">#FF353535</color>
    <color name="ef_chip_dark">#FF2E2E2E</color>

    <!-- 两种模式共用 -->
    <color name="ef_signal">#FFFFFA00</color>
    <color name="ef_on_signal">#FF161616</color>
    <color name="ef_command_bar">#FF161616</color>
    <!-- 三色条：品红 / 黄 / 薄荷绿，只出现在「屏幕开始」与「详情标题下方」 -->
    <color name="ef_tri_a">#FFFF00F0</color>
    <color name="ef_tri_b">#FFFFFA00</color>
    <color name="ef_tri_c">#FF00FFA2</color>

    <!-- 危险：只给删除 -->
    <color name="ef_danger_light">#FFB3261E</color>
    <color name="ef_danger_dark">#FFFF8A7A</color>

    <!-- 标签（编号 No.024 的墨底白字） -->
    <color name="ef_tag_bg_light">#FF161616</color>
    <color name="ef_tag_fg_light">#FFFFFFFF</color>
    <color name="ef_tag_bg_dark">#FF3A3A3A</color>
    <color name="ef_tag_fg_dark">#FFEDEDED</color>

    <color name="ef_scrim_light">#80161616</color>
    <color name="ef_scrim_dark">#A0000000</color>
</resources>
